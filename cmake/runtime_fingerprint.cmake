cmake_minimum_required(VERSION 3.20)

set(FINGERPRINT_TEXT "${BASE_FINGERPRINT}")
foreach(INPUT IN LISTS INPUTS)
    file(SHA256 "${INPUT}" INPUT_HASH)
    string(APPEND FINGERPRINT_TEXT "|${INPUT_HASH}")
endforeach()
string(SHA256 CUBUTTERFLY_RUNTIME_FINGERPRINT "${FINGERPRINT_TEXT}")
file(SHA256 "${LOCAL_SELECTOR}" CUBUTTERFLY_LOCAL_SELECTOR_FINGERPRINT)
configure_file("${TEMPLATE}" "${OUTPUT}" @ONLY)
