digraph cuButterfly {
  graph [rankdir=TB, bgcolor="transparent", pad=0.18, nodesep=0.30,
         ranksep=0.40, fontname="Helvetica", newrank=true];
  node [shape=box, style="rounded,filled", color="#354052", fillcolor="#f7f8fa",
        fontcolor="#17202a", fontname="Helvetica", fontsize=12, margin="0.15,0.12"];
  edge [color="#596579", penwidth=1.3, arrowsize=0.7, fontname="Helvetica", fontsize=10];

  request [label="Semantic request + workload\nFFT / NTT / FWHT / zeta / structured\nprecision, order, direction\nshape, batch, layout",
           fillcolor="#e8f1fb", color="#27658f"];
  regions [label="Dependency construction\nstage bands + closed regions\nintersections + predecessor sets",
           fillcolor="#eef7ec", color="#3f7d43"];
  organization [label="Hierarchical hybrid dataflow\nstage / data: spatial + temporal\nlive state, traffic, core work\nand ready work",
                fillcolor="#eef7ec", color="#3f7d43"];
  inputs [label="Compatible implementation inputs\n\nArithmetic cores\nsupport, value roles, resources\n\nStatic target profiles\ncapacity, services, coverage",
          fillcolor="#f5ebf8", color="#7d4b8f"];
  prepare [label="Prepare a legal realization\nconstraints → rank / tune\ncompile / check → cache\nreport actual mapping",
           fillcolor="#fff3dc", color="#9a6a16"];
  execute [label="Execute tile subgraphs\nlocal core + bounded residency\nproducer write → consumer read\npublication + buffer reuse",
           fillcolor="#e8f1fb", color="#27658f"];
  evidence [label="Complete-call evidence\nmatched baseline / fixed-core control\nordinary timing + diagnostic profile",
            fillcolor="#fbeaea", color="#9b4444"];

  {rank=same; request; regions; organization;}
  {rank=same; inputs; prepare; execute;}
  request -> regions;
  regions -> organization;
  request -> inputs [style=invis];
  regions -> prepare [label="legal dependencies"];
  organization -> prepare [label="resource demands"];
  inputs -> prepare;
  prepare -> execute [label="prepared plan"];
  execute -> evidence;
  evidence -> inputs [label="explicit calibration / tuning", style=dashed,
                      color="#9b4444", constraint=false];
}
