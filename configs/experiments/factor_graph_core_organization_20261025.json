{
  "schema": "cubutterfly-explicit-graph-suite-v1",
  "purpose": "Fixed-core organization transfer: matched organization control, not external-library native performance or AUTO selection",
  "core_provenance": {
    "register-tile": "Auditable existing NativeFactor implementation in src/fft_factor_native.cuh",
    "cufftdx-block": "Existing cuFFTDx block provider under the public factor-streamed organization"
  },
  "operator": "fft", "precision": "fp64", "logN": 16, "batch": 16,
  "inverse": false, "seed": 6143, "warmup": 5, "repeat": 30, "trials": 7,
