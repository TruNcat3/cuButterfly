    "fft_core": "cufftdx-block", "compute_unit": "auto",
    "shared_layout": "writer-aligned", "cross_twiddle": "recurrence",
    "stage_partition": [20], "factor_partition": [10, 10],
    "factor_ept": 8, "factor_columns": 4,
    "data_tiles_per_cta": 1, "prefetch_depth": 0,
    "factor_io_policies": ["dynamic", "dynamic"]
  },
  "cases": [
    {"id": "t1-d0", "mapping": {}},
    {"id": "t1-d1-no-future-tile", "mapping": {"prefetch_depth": 1}},
    {"id": "t2-d0", "mapping": {"data_tiles_per_cta": 2}},
    {"id": "t2-d1", "mapping": {"data_tiles_per_cta": 2, "prefetch_depth": 1}},
    {"id": "t4-d0", "mapping": {"data_tiles_per_cta": 4}},
    {"id": "t4-d1", "mapping": {"data_tiles_per_cta": 4, "prefetch_depth": 1}},
    {"id": "cufft", "mapping": {"backend": "cufft"}, "inherit_base": false}
  ]
}
