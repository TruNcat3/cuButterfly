{
  "schema": "cubutterfly-explicit-graph-suite-v1",
  "purpose": "Controlled factor-streamed supply scan: tile reuse versus cp.async depth on the same cuFFTDx block core",
  "operator": "fft", "precision": "fp64", "logN": 20, "batch": 16,
  "inverse": false, "seed": 6143, "warmup": 5, "repeat": 30, "trials": 7,
  "base_mapping": {
